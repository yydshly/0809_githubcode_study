{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://single-image-studio.invalid/research/slice-06/schemas/diagnostic-envelope.slice06.v0.schema.json",
  "title": "DiagnosticEnvelope.slice06.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "diagnosticEnvelopeId", "recordClass", "artifactEligible", "strictDecision", "mode", "operation", "requestRef", "attempt", "outcomeClass", "primaryCode", "secondaryCodes", "candidateOutputObservationRef", "oracleDiagnosticRef", "worker", "rights", "retention", "publication", "cleanup", "createdAt", "evidenceBoundary", "contentHash"],
  "properties": {
    "schemaVersion": { "const": "diagnostic-envelope.slice06.v0" },
    "diagnosticEnvelopeId": { "$ref": "#/$defs/id" },
    "recordClass": { "const": "durable-diagnostic-not-artifact" },
    "artifactEligible": { "const": false },
    "strictDecision": { "enum": ["pass", "non-pass"] },
    "mode": { "const": "open-diagnostic" },
    "operation": { "$ref": "#/$defs/operation" },
    "requestRef": { "$ref": "#/$defs/hashRef" },
    "attempt": { "$ref": "#/$defs/attempt" },
    "outcomeClass": { "enum": ["oracle-pass", "oracle-nonpass", "output-nonpass", "worker-failure", "lifecycle-unknown"] },
    "primaryCode": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
    "secondaryCodes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 240 }, "uniqueItems": true, "maxItems": 32 },
    "candidateOutputObservationRef": { "oneOf": [{ "$ref": "#/$defs/hashRef" }, { "type": "null" }] },
    "oracleDiagnosticRef": { "oneOf": [{ "$ref": "#/$defs/hashRef" }, { "type": "null" }] },
    "worker": { "$ref": "#/$defs/worker" },
    "rights": { "$ref": "#/$defs/rights" },
    "retention": { "$ref": "#/$defs/retention" },
    "publication": { "$ref": "#/$defs/publication" },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "createdAt": { "$ref": "#/$defs/utc" },
    "evidenceBoundary": { "$ref": "#/$defs/evidenceBoundary" },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "operation": { "enum": ["normalize", "export"] },
    "hashRef": {
      "type": "object", "additionalProperties": false, "required": ["id", "contentHash"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "contentHash": { "$ref": "#/$defs/sha256" } }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "sourceId", "partition", "repetition", "attemptNumber", "idempotencyKey"],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9@._-]*$" },
        "partition": { "const": "diagnostic" },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
        "attemptNumber": { "const": 1 },
        "idempotencyKey": { "$ref": "#/$defs/id" }
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["rightsRef", "assetClass", "containsRealPerson", "realUserPhotosUsed", "thirdPartyAssetsUsed", "modelWeightsUsed", "candidateDerivativeRepositoryRetention", "diagnosticPublicDisplay"],
      "properties": {
        "rightsRef": { "$ref": "#/$defs/hashRef" },
        "assetClass": { "const": "project-original-deterministic-synthetic-open-research-fixtures" },
        "containsRealPerson": { "const": false }, "realUserPhotosUsed": { "const": false }, "thirdPartyAssetsUsed": { "const": false }, "modelWeightsUsed": { "const": false },
        "candidateDerivativeRepositoryRetention": { "type": "boolean" }, "diagnosticPublicDisplay": { "type": "boolean" }
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "reasonCode", "policyRef", "maxPerOutputBytes", "maxSessionBytes"],
      "properties": {
        "state": { "enum": ["retained", "hash-only"] },
        "reasonCode": { "enum": ["S06_DIAGNOSTIC_RETENTION_AUTHORIZED_OPEN_SYNTHETIC", "S06_DIAGNOSTIC_RETENTION_HASH_ONLY"] },
        "policyRef": { "$ref": "#/$defs/hashRef" }, "maxPerOutputBytes": { "const": 1048576 }, "maxSessionBytes": { "const": 18874368 }
      }
    },
    "resourceUsage": {
      "type": "object", "additionalProperties": false,
      "required": ["maxRssKiB", "userCpuMicros", "systemCpuMicros"],
      "properties": {
        "maxRssKiB": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "userCpuMicros": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "systemCpuMicros": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "workerMessage": {
      "type": "object", "additionalProperties": false,
      "required": ["received", "receivedAt", "protocolVersion", "status", "payloadSha256"],
      "properties": {
        "received": { "type": "boolean" },
        "receivedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "protocolVersion": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
        "status": { "enum": ["succeeded", "failed", null] },
        "payloadSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "workerRuntime": {
      "type": "object", "additionalProperties": false, "required": ["payloadSha256", "matchesFrozen"],
      "properties": { "payloadSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }, "matchesFrozen": { "type": ["boolean", "null"] } }
    },
    "workerTelemetry": {
      "type": "object", "additionalProperties": false, "required": ["source", "workerDurationMs", "resourceUsage"],
      "properties": {
        "source": { "enum": ["worker-self-reported-not-hard-isolation", null] },
        "workerDurationMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "resourceUsage": { "oneOf": [{ "$ref": "#/$defs/resourceUsage" }, { "type": "null" }] }
      }
    },
    "parentWall": {
      "type": "object", "additionalProperties": false,
      "required": ["startedAt", "messageAt", "exitedAt", "finishedAt", "durationMs"],
      "properties": {
        "startedAt": { "$ref": "#/$defs/utc" },
        "messageAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "exitedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "finishedAt": { "$ref": "#/$defs/utc" },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 11000 }
      }
    },
    "exit": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmed", "exitCode", "signal", "terminationRequested"],
      "properties": {
        "confirmed": { "type": "boolean" },
        "exitCode": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "signal": { "type": ["string", "null"], "minLength": 1, "maxLength": 40 },
        "terminationRequested": { "type": "boolean" }
      }
    },
    "worker": {
      "type": "object", "additionalProperties": false, "required": ["message", "runtime", "telemetry", "parentWall", "exit"],
      "properties": {
        "message": { "$ref": "#/$defs/workerMessage" }, "runtime": { "$ref": "#/$defs/workerRuntime" }, "telemetry": { "$ref": "#/$defs/workerTelemetry" }, "parentWall": { "$ref": "#/$defs/parentWall" }, "exit": { "$ref": "#/$defs/exit" }
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false, "required": ["state", "transactionId", "publishedAt", "fileRoles"],
      "properties": {
        "state": { "enum": ["not-published", "committed", "reconciliation-unknown"] },
        "transactionId": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 },
        "publishedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        "fileRoles": { "type": "array", "items": { "enum": ["candidate-output-bytes", "candidate-output-observation", "oracle-diagnostic", "diagnostic-envelope", "result"] }, "uniqueItems": true, "maxItems": 5 }
      }
    },
    "cleanup": {
      "type": "object", "additionalProperties": false, "required": ["state", "stagingRemoved", "confirmedAt"],
      "properties": {
        "state": { "enum": ["not-required", "confirmed", "unknown"] },
        "stagingRemoved": { "type": ["boolean", "null"] },
        "confirmedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
      }
    },
    "evidenceBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["c1", "u1", "e1", "r1Pipeline", "r1ProductValidation", "r1ProductRelease", "o1", "g1", "v1", "releaseAllowlist", "releaseRegistered", "releaseApproved", "productSupport", "formalEvidence"],
      "properties": {
        "c1": { "const": 0 }, "u1": { "const": 0 }, "e1": { "const": 0 },
        "r1Pipeline": { "const": 0 }, "r1ProductValidation": { "const": 0 }, "r1ProductRelease": { "const": 0 },
        "o1": { "const": 0 }, "g1": { "const": 0 }, "v1": { "const": 0 },
        "releaseAllowlist": { "const": "none" }, "releaseRegistered": { "const": 0 }, "releaseApproved": { "const": 0 },
        "productSupport": { "const": false }, "formalEvidence": { "const": false }
      }
    }
  }
}
