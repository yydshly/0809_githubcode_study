  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactRef": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "byteLength": {
              "maximum": 1048576,
              "minimum": 1,
              "type": "integer"
            },
            "contentHash": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "decodedPixelSha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "fileSha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "id": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$",
              "type": "string"
            },
            "recordByteLength": {
              "minimum": 1,
              "type": "integer"
            },
            "recordFileSha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "recordRelativePath": {
              "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9._@/-]+$",
              "type": "string"
            },
            "relativePath": {
              "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9._@/-]+$",
              "type": "string"
            },
            "schemaVersion": {
              "enum": [
                "normalized-image.slice04.v0",
                "delivery-artifact.slice04.v0"
              ]
            }
          },
          "required": [
            "schemaVersion",
            "id",
            "contentHash",
            "recordRelativePath",
            "recordByteLength",
            "recordFileSha256",
            "relativePath",
            "byteLength",
            "fileSha256",
            "decodedPixelSha256"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "additionalProperties": false,
      "properties": {
        "attemptNumber": {
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        },
        "idempotencyKey": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$",
          "type": "string"
        },
        "partition": {
          "enum": [
            "smoke",
            "dev/calibration",
            "defect/calibration"
          ]
        },
        "repetition": {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "runId": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,255}$",
