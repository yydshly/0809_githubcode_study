{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seal-ceremony-run-receipt.v0.schema.json",
  "title": "Single Image Studio Slice 03 run receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ceremonyRehearsal", "receiptId", "requestId", "rootRequestId", "attemptNumber", "idempotencyKey", "bundleId", "custodianId", "roleAttestation", "execution", "frozenRefs", "requestSha256", "custodyHeadSha256", "receiptSha256"],
  "properties": {
    "schemaVersion": { "const": "seal-ceremony-run-receipt.v0" },
    "ceremonyRehearsal": { "type": "boolean" },
    "receiptId": { "$ref": "#/$defs/id" },
    "requestId": { "$ref": "#/$defs/id" },
    "rootRequestId": { "$ref": "#/$defs/id" },
    "attemptNumber": { "type": "integer", "minimum": 1, "maximum": 4 },
    "idempotencyKey": { "$ref": "#/$defs/id" },
    "bundleId": { "$ref": "#/$defs/id" },
    "custodianId": { "$ref": "#/$defs/id" },
    "roleAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["custodianId", "candidateAuthorIds", "thresholdAuthorIds", "qaProfileAuthorIds", "stoppingRuleAuthorIds", "conflictDetected", "signedAt"],
      "properties": {
        "custodianId": { "$ref": "#/$defs/id" },
        "candidateAuthorIds": { "$ref": "#/$defs/ids" },
        "thresholdAuthorIds": { "$ref": "#/$defs/ids" },
        "qaProfileAuthorIds": { "$ref": "#/$defs/ids" },
        "stoppingRuleAuthorIds": { "$ref": "#/$defs/ids" },
        "conflictDetected": { "const": false },
        "signedAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsealedAt", "startedAt", "completedAt", "outcome", "invalidReason", "rawResultPath"],
      "properties": {
        "unsealedAt": { "$ref": "#/$defs/dateTime" },
        "startedAt": { "$ref": "#/$defs/dateTime" },
        "completedAt": { "$ref": "#/$defs/dateTime" },
        "outcome": { "type": "string", "enum": ["valid", "invalid"] },
        "invalidReason": { "type": ["string", "null"] },
        "rawResultPath": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "frozenRefs": { "$ref": "#/$defs/frozenRefs" },
    "requestSha256": { "$ref": "#/$defs/sha256" },
    "custodyHeadSha256": { "$ref": "#/$defs/sha256" },
    "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dateTime": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "frozenRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preregistrationSha256", "contractSha256", "candidateSha256", "runnerSha256", "formatProfileSha256", "qaProfileSha256", "sealPlanSha256", "bundleSha256"],
      "properties": {
        "preregistrationSha256": { "$ref": "#/$defs/sha256" },
        "contractSha256": { "$ref": "#/$defs/sha256" },
        "candidateSha256": { "$ref": "#/$defs/sha256" },
        "runnerSha256": { "$ref": "#/$defs/sha256" },
        "formatProfileSha256": { "$ref": "#/$defs/sha256" },
        "qaProfileSha256": { "$ref": "#/$defs/sha256" },
        "sealPlanSha256": { "$ref": "#/$defs/sha256" },
        "bundleSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
