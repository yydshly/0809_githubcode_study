# Optional. The app remains usable for local deterministic processing without this key.
OPENAI_API_KEY=

# Optional. Server-side only. Both values are required so a stored key cannot
# accidentally enable paid remote processing. Enable only after the account
# policy, retention boundary, and budget are approved. For sandbox testing,
# prefix the account key once with `sandbox_`; sandbox output is watermarked.
# Never expose this key in browser code or commit a populated .env file.
PHOTOROOM_API_KEY=
PHOTOROOM_ENABLED=false
SINGLE_IMAGE_STUDIO_PORT=4177

# Optional mobile preview. Use `npm.cmd run mobile` instead of setting these by hand.
# LAN preview binds one explicit private IP and always disables OpenAI image edits.
SINGLE_IMAGE_STUDIO_ALLOW_LAN=0
SINGLE_IMAGE_STUDIO_BIND_HOST=127.0.0.1
SINGLE_IMAGE_STUDIO_LAN_IP=
