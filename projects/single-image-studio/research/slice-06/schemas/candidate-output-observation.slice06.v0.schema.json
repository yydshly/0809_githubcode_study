{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://single-image-studio.invalid/research/slice-06/schemas/candidate-output-observation.slice06.v0.schema.json",
  "title": "CandidateOutputObservation.slice06.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateOutputObservationId",
    "recordClass",
    "artifactEligible",
    "strictDecision",
    "mode",
    "operation",
    "requestRef",
    "attempt",
    "candidateRef",
    "adapterRef",
    "workerRef",
    "runtimeRef",
    "hardwareRef",
    "producerRef",
    "rights",
    "retention",
    "bytes",
    "producedAt",
    "evidenceBoundary",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": "candidate-output-observation.slice06.v0" },
    "candidateOutputObservationId": { "$ref": "#/$defs/id" },
    "recordClass": { "const": "diagnostic-candidate-output-not-artifact" },
    "artifactEligible": { "const": false },
    "strictDecision": { "enum": ["pass", "non-pass"] },
    "mode": { "const": "open-diagnostic" },
    "operation": { "$ref": "#/$defs/operation" },
    "requestRef": { "$ref": "#/$defs/hashRef" },
    "attempt": { "$ref": "#/$defs/attempt" },
    "candidateRef": { "$ref": "#/$defs/hashRef" },
    "adapterRef": { "$ref": "#/$defs/implementationRef" },
    "workerRef": { "$ref": "#/$defs/implementationRef" },
    "runtimeRef": { "$ref": "#/$defs/hashRef" },
    "hardwareRef": { "$ref": "#/$defs/hashRef" },
    "producerRef": { "$ref": "#/$defs/implementationRef" },
    "rights": { "$ref": "#/$defs/rights" },
    "retention": { "$ref": "#/$defs/retention" },
    "bytes": { "$ref": "#/$defs/bytes" },
    "producedAt": { "$ref": "#/$defs/utc" },
    "evidenceBoundary": { "$ref": "#/$defs/evidenceBoundary" },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "operation": { "enum": ["normalize", "export"] },
    "hashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentHash"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "contentHash": { "$ref": "#/$defs/sha256" } }
    },
    "implementationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "implementationSha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "implementationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "sourceId", "partition", "repetition", "attemptNumber", "idempotencyKey"],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9@._-]*$" },
        "partition": { "const": "diagnostic" },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
        "attemptNumber": { "const": 1 },
        "idempotencyKey": { "$ref": "#/$defs/id" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rightsRef", "assetClass", "containsRealPerson", "realUserPhotosUsed", "thirdPartyAssetsUsed", "modelWeightsUsed", "candidateDerivativeRepositoryRetention", "diagnosticPublicDisplay"],
      "properties": {
        "rightsRef": { "$ref": "#/$defs/hashRef" },
        "assetClass": { "const": "project-original-deterministic-synthetic-open-research-fixtures" },
        "containsRealPerson": { "const": false },
        "realUserPhotosUsed": { "const": false },
        "thirdPartyAssetsUsed": { "const": false },
        "modelWeightsUsed": { "const": false },
        "candidateDerivativeRepositoryRetention": { "type": "boolean" },
        "diagnosticPublicDisplay": { "type": "boolean" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCode", "policyRef", "maxPerOutputBytes", "maxSessionBytes"],
      "properties": {
        "state": { "enum": ["retained", "hash-only"] },
        "reasonCode": { "enum": ["S06_DIAGNOSTIC_RETENTION_AUTHORIZED_OPEN_SYNTHETIC", "S06_DIAGNOSTIC_RETENTION_HASH_ONLY"] },
        "policyRef": { "$ref": "#/$defs/hashRef" },
        "maxPerOutputBytes": { "const": 1048576 },
        "maxSessionBytes": { "const": 18874368 }
      }
    },
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "mediaType", "byteLength", "fileSha256"],
      "properties": {
        "relativePath": { "type": ["string", "null"], "maxLength": 500, "pattern": "^(specimens|quarantine)/(normalize|export)/[A-Za-z0-9][A-Za-z0-9@._-]{0,119}/r[1-3]/candidate-output\\.bin$" },
        "mediaType": { "const": "application/octet-stream" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "fileSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "evidenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c1", "u1", "e1", "r1Pipeline", "r1ProductValidation", "r1ProductRelease", "o1", "g1", "v1", "releaseAllowlist", "releaseRegistered", "releaseApproved", "productSupport", "formalEvidence"],
      "properties": {
        "c1": { "const": 0 }, "u1": { "const": 0 }, "e1": { "const": 0 },
        "r1Pipeline": { "const": 0 }, "r1ProductValidation": { "const": 0 }, "r1ProductRelease": { "const": 0 },
        "o1": { "const": 0 }, "g1": { "const": 0 }, "v1": { "const": 0 },
        "releaseAllowlist": { "const": "none" }, "releaseRegistered": { "const": 0 }, "releaseApproved": { "const": 0 },
        "productSupport": { "const": false }, "formalEvidence": { "const": false }
      }
    }
  }
}
