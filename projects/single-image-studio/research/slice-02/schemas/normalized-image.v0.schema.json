{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalized-image.v0.schema.json",
  "title": "Single Image Studio NormalizedImage v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "normalizedImageId", "parentImageAssetId", "capabilityContractRef", "mime", "width", "height", "orientation", "colorProfile", "alphaPresent", "premultiply", "metadataPolicy", "pixelSha256", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "normalized-image.v0" }, "normalizedImageId": { "$ref": "#/$defs/string" },
    "parentImageAssetId": { "$ref": "#/$defs/string" }, "capabilityContractRef": { "const": "CC-CAP02-NORMALIZE@0.2.0" },
    "mime": { "const": "image/png" }, "width": { "type": "integer", "minimum": 1, "maximum": 256 },
    "height": { "type": "integer", "minimum": 1, "maximum": 256 }, "orientation": { "const": 1 },
    "colorProfile": { "const": "srgb" }, "alphaPresent": { "type": "boolean" }, "premultiply": { "const": "straight" },
    "metadataPolicy": { "const": "strip-all-except-color-contract" }, "pixelSha256": { "$ref": "#/$defs/sha256" },
    "createdAt": { "$ref": "#/$defs/dateTime" }
  },
  "$defs": {
    "string": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dateTime": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
