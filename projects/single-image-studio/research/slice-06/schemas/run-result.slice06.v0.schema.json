{
  "$id": "https://single-image-studio.invalid/research/slice-06/schemas/run-result.slice06.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "additionalProperties": false,
      "properties": {
        "attemptNumber": {
          "const": 1
        },
        "idempotencyKey": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "type": "string"
        },
        "partition": {
          "const": "diagnostic"
        },
        "repetition": {
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "runId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "type": "string"
        },
        "sourceId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "type": "string"
        }
      },
      "required": [
        "runId",
        "sourceId",
        "partition",
        "repetition",
        "attemptNumber",
        "idempotencyKey"
      ],
      "type": "object"
    },
    "contentHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "diagnosticEnvelopeRef": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contentHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
              "type": "string"
            },
            "relativePath": {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@/-]+$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "contentHash",
            "relativePath"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnosticFacts": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "candidateOutputByteLength": {
              "maximum": 1048576,
              "minimum": 1,
              "type": "integer"
            },
            "candidateOutputDecodedPixelSha256": {
              "oneOf": [
                {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "candidateOutputFileSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "oracleFindingCodes": {
              "items": {
                "pattern": "^S06_[A-Z0-9_]+$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "oraclePrimaryCode": {
              "oneOf": [
                {
                  "pattern": "^S06_[A-Z0-9_]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "strictDecision": {
              "enum": [
                "pass",
                "non-pass"
              ]
            },
            "telemetryComplete": {
              "const": true
            },
            "workerExitCode": {
              "const": 0
            },
            "workerExitConfirmed": {
              "const": true
            },
            "workerExitSignal": {
              "type": "null"
            },
            "workerRuntimePayloadSha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "strictDecision",
            "candidateOutputByteLength",
            "candidateOutputFileSha256",
            "candidateOutputDecodedPixelSha256",
            "oraclePrimaryCode",
            "oracleFindingCodes",
            "workerRuntimePayloadSha256",
            "workerExitConfirmed",
            "workerExitCode",
            "workerExitSignal",
            "telemetryComplete"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceBoundary": {
      "additionalProperties": false,
      "properties": {
        "c1": {
          "const": 0
        },
        "calibrationAuthorized": {
          "const": false
        },
        "e1": {
          "const": 0
        },
        "excludedFromGateB": {
          "const": true
        },
        "formal": {
          "const": false
        },
        "g1": {
          "const": 0
        },
        "gateBDecisionAuthority": {
          "const": false
        },
        "o1": {
          "const": 0
        },
        "productSupport": {
          "const": false
        },
        "r1Pipeline": {
          "const": 0
        },
        "r1ProductRelease": {
          "const": 0
        },
        "r1ProductValidation": {
          "const": 0
        },
        "releaseAllowlist": {
          "const": "none"
        },
        "releaseApproved": {
          "const": 0
        },
        "releaseRegistered": {
          "const": 0
        },
        "u1": {
          "const": 0
        },
        "v1": {
          "const": 0
        }
      },
      "required": [
        "formal",
        "productSupport",
        "excludedFromGateB",
        "gateBDecisionAuthority",
        "calibrationAuthorized",
        "c1",
        "u1",
        "e1",
        "r1Pipeline",
        "r1ProductValidation",
        "r1ProductRelease",
        "o1",
        "g1",
        "v1",
        "releaseAllowlist",
        "releaseRegistered",
        "releaseApproved"
      ],
      "type": "object"
    },
    "expectedDisposition": {
      "enum": [
        "applicable",
        "preflight-reject"
      ]
    },
    "expectedStableErrorCode": {
      "oneOf": [
        {
          "pattern": "^S06_[A-Z0-9_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "finishedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "idempotencyKeyHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "mode": {
      "const": "open-diagnostic"
    },
    "operation": {
      "enum": [
        "normalize",
        "export"
      ]
    },
    "publication": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "atomicDirectoryCommit": {
              "const": true
            },
            "rolePaths": {
              "additionalProperties": false,
              "properties": {
                "candidateOutput": {
                  "maxLength": 500,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:@/-]+$",
                  "type": "string"
                },
                "candidateOutputObservation": {
                  "maxLength": 500,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:@/-]+$",
                  "type": "string"
                },
                "diagnosticEnvelope": {
                  "maxLength": 500,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:@/-]+$",
                  "type": "string"
                },
                "oracleDiagnostic": {
                  "maxLength": 500,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:@/-]+$",
                  "type": "string"
                },
                "terminalResult": {
                  "maxLength": 500,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9._:@/-]+$",
                  "type": "string"
                }
              },
              "required": [
                "candidateOutput",
                "candidateOutputObservation",
                "oracleDiagnostic",
                "diagnosticEnvelope",
                "terminalResult"
              ],
              "type": "object"
            },
            "rootRelativePath": {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@/-]+$",
              "type": "string"
            }
          },
          "required": [
            "rootRelativePath",
            "atomicDirectoryCommit",
            "rolePaths"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasonCode": {
      "oneOf": [
        {
          "pattern": "^S06_[A-Z0-9_]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestRef": {
      "additionalProperties": false,
      "properties": {
        "contentHash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "contentHash"
      ],
      "type": "object"
    },
    "resultId": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "run-result.slice06.v0"
    },
    "startedAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "status": {
      "enum": [
        "characterized-oracle-pass",
        "characterized-oracle-non-pass",
        "characterized-preflight-rejection",
        "protocol-failed",
        "inconclusive"
      ]
    },
    "workerFailureEnvelopeRef": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contentHash": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "id": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$",
              "type": "string"
            },
            "relativePath": {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:@/-]+$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "contentHash",
            "relativePath"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "workerInvoked": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "resultId",
    "requestRef",
    "idempotencyKeyHash",
    "mode",
    "operation",
    "attempt",
    "expectedDisposition",
    "expectedStableErrorCode",
    "status",
    "reasonCode",
    "workerInvoked",
    "diagnosticEnvelopeRef",
    "workerFailureEnvelopeRef",
    "diagnosticFacts",
    "publication",
    "startedAt",
    "finishedAt",
    "evidenceBoundary",
    "contentHash"
  ],
  "type": "object"
}
