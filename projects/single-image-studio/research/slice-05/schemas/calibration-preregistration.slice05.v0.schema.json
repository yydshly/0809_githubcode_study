          "const": 0,
          "type": "integer"
        },
        "defectHoldoutAtDefinitionFreeze": {
          "const": "not-created",
          "type": "string"
        },
        "escapeAtDefinitionFreeze": {
          "const": "not-created",
          "type": "string"
        },
        "formalRunsAllowed": {
          "const": false,
          "type": "boolean"
        },
        "holdoutAtDefinitionFreeze": {
          "const": "not-created",
          "type": "string"
        }
