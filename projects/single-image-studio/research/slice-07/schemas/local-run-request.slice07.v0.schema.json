{
  "$id": "https://single-image-studio.invalid/research/slice-07/schemas/local-run-request.slice07.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$",
      "type": "string"
    },
    "contentHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "applicable",
        "rejection"
      ]
    },
    "evidenceBoundary": {
      "additionalProperties": false,
      "properties": {
        "C1": {
          "const": 0
        },
        "E1": {
          "const": 0
        },
        "G1": {
          "const": 0
        },
        "O1": {
          "const": 0
        },
        "R1": {
          "const": 0
        },
        "U1": {
          "const": 0
        },
        "V1": {
          "const": 0
        },
        "formal": {
          "const": false
        },
        "productSupport": {
          "const": false
        },
        "releaseAllowlist": {
          "const": "none"
        },
        "releaseApproved": {
          "const": 0
        },
        "releaseRegistered": {
          "const": 0
        }
      },
      "required": [
        "C1",
        "U1",
        "E1",
        "R1",
        "O1",
        "G1",
        "V1",
        "productSupport",
        "formal",
        "releaseAllowlist",
        "releaseRegistered",
        "releaseApproved"
      ],
      "type": "object"
    },
    "expectedStableErrorCode": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^S07_[A-Z0-9_]+$",
          "type": "string"
        }
      ]
    },
    "operation": {
      "enum": [
        "normalize",
        "export"
      ]
    },
    "repetition": {
      "maximum": 3,
      "minimum": 1,
      "type": "integer"
    },
    "requestId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "local-run-request.slice07.v0"
    },
    "sourceId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "attemptId",
    "operation",
    "sourceId",
    "repetition",
    "disposition",
    "expectedStableErrorCode",
    "evidenceBoundary",
    "contentHash"
  ],
  "type": "object"
}
