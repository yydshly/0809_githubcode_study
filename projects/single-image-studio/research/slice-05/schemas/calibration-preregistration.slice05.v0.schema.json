              "const": 18,
              "type": "integer"
            },
            "rejection": {
              "const": 12,
              "type": "integer"
            },
            "sources": {
              "const": 30,
              "type": "integer"
            }
          },
          "required": [
            "sources",
            "applicable",
            "rejection"
          ],
          "type": "object"
        },
        "repetitionsPerSource": {
          "const": 3,
          "type": "integer"
        },
        "totalPlannedAttempts": {
          "const": 144,
          "type": "integer"
        },
        "totalSources": {
          "const": 48,
          "type": "integer"
        }
      },
      "required": [
        "devCalibration",
        "defectCalibration",
        "repetitionsPerSource",
        "totalSources",
        "totalPlannedAttempts"
      ],
      "type": "object"
    },
    "evidenceBoundary": {
      "$ref": "#/$defs/evidenceBoundary"
    },
    "formalBoundary": {
      "additionalProperties": false,
      "properties": {
